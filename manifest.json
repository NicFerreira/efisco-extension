{
  "manifest_version": 3,
  "name": "Automação e-Fisco Diárias",
  "version": "1.3",
  "description": "Painel lateral para lançamento de diárias no e-Fisco.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "efiscologo.png",
    "48": "efiscologo.png",
    "128": "efiscologo.png"
  },
  "action": {
    "default_title": "Abrir Painel e-Fisco",
    "default_icon": {
      "16": "efiscologo.png",
      "48": "efiscologo.png",
      "128": "efiscologo.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"]
    }
  ]
}